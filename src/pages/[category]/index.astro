---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, CATEGORIES } from '../../site.config.mjs';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const cat = CATEGORIES[category as keyof typeof CATEGORIES];
const posts = (await getCollection('posts', (p) => !p.data.draft && p.data.category === category))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const siteUrl = new URL('/', Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: cat.title,
      description: cat.description,
      url: new URL(Astro.url.pathname, Astro.site).href,
      inLanguage: 'zh-TW',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首頁', item: siteUrl },
        { '@type': 'ListItem', position: 2, name: cat.name, item: new URL(Astro.url.pathname, Astro.site).href },
      ],
    },
  ],
};
---
<Base title={`${cat.title} - ${SITE.name}`} description={cat.description} jsonLd={jsonLd}>
  <main class="wrap narrow article">
    <nav class="crumbs" aria-label="麵包屑"><a href="/">首頁</a> › {cat.name}</nav>
    <h1>{cat.name}</h1>
    <p>{cat.intro}</p>
    {posts.length === 0 && <p class="src">文章準備中，敬請期待。</p>}
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={`/${category}/${p.id}/`}>{p.data.title}</a>
          <p>{p.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Base>
