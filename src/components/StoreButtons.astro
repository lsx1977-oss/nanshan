---
import { SITE } from '../site.config.mjs';
interface Props { icons?: boolean; light?: boolean }
const { icons = false, light = false } = Astro.props;
---
<div class="cta">
  <a class="btn btn-primary" href={SITE.appStoreUrl} rel="noopener">
    {icons && (
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.5 2-3.7 2.1-3.8-1.2-1.7-3-1.9-3.6-2-1.5-.2-3 .9-3.8.9-.8 0-2-.9-3.3-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8s2 .8 3.3.8c1.4 0 2.3-1.2 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.8-1-2.8-4.2zM14 5.1c.7-.9 1.2-2 1-3.1-1 0-2.2.7-2.9 1.5-.6.7-1.2 1.9-1 3 1.1.1 2.2-.6 2.9-1.4z"/></svg>
    )}
    App Store 下載
  </a>
  <a class:list={['btn', light ? 'btn-ghost-light' : 'btn-ghost']} href={SITE.playUrl} rel="noopener">
    {icons && (
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.3c-.3.3-.4.7-.4 1.2v17c0 .5.1.9.4 1.2l9.5-9.7-9.5-9.7zm10.7 10.9 2.9 3-11.1 6.3 8.2-9.3zm0-2.4L6.1 1.5l11.1 6.3-2.9 3zm4.2-1.9 3 1.7c.9.5.9 1.9 0 2.4l-3 1.7-3.2-2.9 3.2-2.9z"/></svg>
    )}
    Google Play 下載
  </a>
</div>
